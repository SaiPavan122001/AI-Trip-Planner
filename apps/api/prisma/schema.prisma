// Database schema.
//
// Planning sessions are stored as a validated JSON document alongside the
// columns worth querying and indexing. The document shape is owned by the Zod
// schemas in @trip/shared, which are the real contract; mirroring forty
// optional preference fields into columns would mean a migration every time a
// question is added, for no query anybody runs.
//
// Bookings are the opposite: every column matters, because they are money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person using the planner. Someone who has not signed in still has a row,
/// with no email: their trips belong to it, and signing in later attaches an
/// email to the same row (or moves the trips to the account that owns it), so
/// nothing they planned is lost.
model User {
  id          String  @id @default(uuid())
  /// Null until the person signs in with an email link.
  email       String? @unique
  displayName String?
  /// Unused. Sign-in is by emailed link; the column is kept because removing
  /// it would be a destructive migration for no benefit.
  passwordHash String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trips    Trip[]
  bookings Booking[]
  sessions AuthSession[]

  @@map("users")
}

model Trip {
  id      String  @id @default(uuid())
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  stage String

  // Denormalised for listing a traveller's trips without parsing the document.
  originName      String
  destinationName String
  departureDate   String
  returnDate      String?
  travelerCount   Int
  currency        String
  scope           String

  /// The full PlanningSession document, validated against @trip/shared on read.
  session Json

  /// Optimistic-locking counter: a save only succeeds if this is still the
  /// value the caller read, and increments it.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
  travelers TravelerRecord[]
  events    AuditEvent[]
  runs      PlanningRun[]

  @@index([ownerId, updatedAt])
  @@map("trips")
}

model Booking {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  component String
  state     String
  provider  String

  /// Set only from a provider response. Its presence is what proves a booking exists.
  providerReference String?

  quotedAmount    Int
  quotedCurrency  String
  confirmedAmount Int?

  /// Makes a retried booking request safe: the same key returns the same booking.
  idempotencyKey String @unique

  /// Full transition history, appended to on every event.
  history Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, state])
  @@map("bookings")
}

/// Traveller identity documents, kept in their own table so retention and
/// access rules apply to one place. Encrypted at rest by the application
/// before insert; never written to logs.
model TravelerRecord {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  travelerIndex Int
  /// Application-encrypted payload; the plaintext never reaches the database.
  encrypted     Bytes
  /// Nonce for the encryption above.
  nonce         Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, travelerIndex])
  @@map("traveler_records")
}

model IdempotencyKey {
  key   String @id
  scope String

  /// Null while the first request is still in flight.
  response Json?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Append-only trail of what the planner decided and what the traveller
/// agreed to, including every waiver of a hard constraint.
model AuditEvent {
  id     String  @id @default(uuid())
  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  kind    String
  actor   String
  detail  Json
  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
  @@map("audit_events")
}

/// A browser or device signed in as a user. Only a keyed hash of the cookie
/// token is stored, so a copy of this table cannot be used to impersonate.
model AuthSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// A single-use, short-lived sign-in link sent by email. As with sessions, only
/// a hash of the token is kept.
model LoginChallenge {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique
  /// The anonymous user who asked, whose trips follow them into the account.
  anonymousUserId String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  consumedAt DateTime?

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// One background search for a trip. A worker takes it with a lease
/// (FOR UPDATE SKIP LOCKED), renews the lease while it works, and a run whose
/// lease lapses is picked up again, so a crashed worker loses nothing.
///
/// The migration adds a partial unique index on trip_id where the run is
/// queued or running: a trip has at most one active run, enforced by the
/// database rather than by hoping two requests do not race. Prisma cannot
/// express a partial index, so it lives in the migration SQL only.
model PlanningRun {
  id      String @id @default(uuid())
  tripId  String
  trip    Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ownerId String?

  /// plan | replan
  kind   String
  /// queued | running | succeeded | failed | cancelled | superseded
  status String

  /// Hash of everything the search depends on. A result is only saved if the
  /// trip still has the same inputs when the search finishes.
  inputsHash  String
  /// The trip version the run was created against.
  baseVersion Int
  /// What to keep from the earlier plan, and why the run exists.
  params      Json

  progress Json?
  error    Json?

  attempts        Int       @default(0)
  workerId        String?
  leaseUntil      DateTime?
  cancelRequested Boolean   @default(false)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
  @@index([tripId, createdAt])
  @@index([ownerId, createdAt])
  @@map("planning_runs")
}

/// Phase 8: the knowledge index, a curated body of documents (policies, rules,
/// guides) that questions are answered from. It is shared and holds nothing
/// that belongs to one traveller: there is no owner column, on purpose.
///
/// A document has one active row per (namespace, docId), enforced by a partial
/// unique index in the migration (Prisma cannot express it); a quarantined
/// attempt is a row of its own and never has chunks.
model KnowledgeDocument {
  rowId             String   @id @default(uuid())
  namespace         String
  docId             String
  title             String
  url               String?
  reference         String
  sourceType        String
  authority         Int
  version           Int
  effectiveDate     String
  reviewBy          String?
  topic             String?
  destination       String?
  /// SHA-256 of the cleaned text.
  contentHash       String
  /// active | quarantined
  status            String
  quarantineReasons Json     @default("[]")
  chunkCount        Int
  previousVersions  Json     @default("[]")
  /// The embedding space its chunks live in (model@version:dimension).
  embeddingSpace    String?
  ingestedAt        DateTime

  chunks KnowledgeChunk[]

  @@unique([namespace, docId, version, contentHash])
  @@index([namespace, status])
  @@index([namespace, contentHash])
  @@map("knowledge_documents")
}

/// A searchable piece of a document, with its vector (little-endian float32)
/// and the document facts retrieval filters on, copied so a search reads one
/// table. Vectors are only ever compared within one (namespace, space).
model KnowledgeChunk {
  namespace     String
  id            String
  docRowId      String
  doc           KnowledgeDocument @relation(fields: [docRowId], references: [rowId], onDelete: Cascade)
  docId         String
  version       Int
  position      Int
  heading       String
  text          String
  startChar     Int
  endChar       Int
  hash          String
  space         String
  vector        Bytes
  title         String
  url           String?
  reference     String
  sourceType    String
  authority     Int
  effectiveDate String
  reviewBy      String?
  topic         String?
  destination   String?

  @@id([namespace, id])
  @@index([namespace, space])
  @@index([docRowId])
  @@map("knowledge_chunks")
}
