###############################################################################
# Wayfare — environment configuration
#
# Copy to `.env` and fill in what you have. Nothing here is required to start
# the service: every travel provider is optional, and the planner reports
# exactly which sources it cannot search rather than substituting estimates.
#
# Never commit a filled-in .env. It is git-ignored for a reason.
###############################################################################

# ─── Service ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Currency: every trip is planned in Indian rupees (INR). There is no setting
# for it, and provider prices in any other currency are set aside with a
# visible reason rather than converted at an invented rate.

# Requests a person may make in the window, across every route; and the same
# counted for an address whoever the person says they are, which is what stops
# clearing cookies from restarting a limit (keep it well above the first: people
# share addresses). The per-route limits (searches, changes, sign-in emails,
# account export) are in apps/api/src/security/rate-limit.ts.
RATE_LIMIT_MAX=120
RATE_LIMIT_ADDRESS_MAX=600
RATE_LIMIT_WINDOW=1 minute
# The largest request body accepted, in bytes. Larger is refused with 413.
MAX_BODY_BYTES=65536

# Which proxies to believe about a caller's address, for rate limiting:
#   false (default) none · true any · 1 (a number) that many hops · a list of
#   addresses or CIDRs. Set this to match the proxy in front of the API (a
#   load balancer, a platform router). Wrong in either direction hurts: too
#   trusting lets callers pick their own identity; too strict rate-limits
#   everyone behind the proxy as one.
TRUST_PROXY=false

# ─── Background searches ─────────────────────────────────────────────────────
# Planning runs in the background: a request queues a search and returns at
# once, and a worker carries it out. By default this process runs the worker
# itself. To run workers separately (scaling, or keeping searches off the API's
# CPU), set RUN_WORKER=false here and start "npm run start:worker -w @trip/api"
# elsewhere with the same DATABASE_URL. Any number of workers may run.
RUN_WORKER=true
# Ceiling on one search, in ms. Providers that exceed it are cut short and the
# search is reported as timed out, never left to hold a worker.
PLANNING_TIMEOUT_MS=60000
# A worker holds a search for this long and renews it while it works; a search
# whose worker died is taken up by another once the lease lapses.
RUN_LEASE_MS=30000
RUN_POLL_MS=1000
RUN_MAX_ATTEMPTS=3
RUN_CONCURRENCY=2
# Ceiling on one language-model call made by a planning agent, in ms. Past it
# the agent falls back to its rules and the search carries on.
AGENT_TIMEOUT_MS=15000
# Searches one person may start per day. Each calls paid provider APIs.
PLAN_RUNS_PER_DAY_ANONYMOUS=15
PLAN_RUNS_PER_DAY_SIGNED_IN=60
# Searches an address may start in a day through anonymous sessions, however many
# it makes: a new anonymous session is one cleared cookie away, so the address is
# what bounds them. Signed-in people are held to their own allowance instead.
PLAN_RUNS_PER_DAY_PER_ADDRESS=60
# Overload protection. Searches waiting for a worker, across everyone: past it, new
# searches are turned away at once (503 with Retry-After) rather than queued to fail.
MAX_QUEUED_RUNS=200
# Searches one person may have queued or running at once, across all their trips.
MAX_ACTIVE_RUNS_PER_USER=3
# A search that has waited this long for a worker is dropped, not served late.
RUN_QUEUE_TIMEOUT_MS=300000
# The most HTTP requests one search may make to providers: a ceiling against
# runaway work, not a target (a normal search makes a few dozen).
MAX_PROVIDER_REQUESTS_PER_SEARCH=200
# A session ends this many days after it began, however often it was used.
SESSION_MAX_DAYS=90
# GET /v1/providers names the settings that would enable a missing provider, and
# GET /v1/providers/health makes live (some billed) calls. Both default to on in
# development and off in production, where they tell an outsider about the deployment.
# EXPOSE_PROVIDER_DETAILS=false
# EXPOSE_PROVIDER_HEALTH=false

# ─── Observability ───────────────────────────────────────────────────────────
# Logs, traces and metrics share identifiers (requestId, runId, tripId, traceId); see
# docs/observability.md. Nothing a traveller wrote, no cookie or token, no email address
# and no prompt is ever recorded.
TELEMETRY_ENABLED=true
# Send traces over OTLP/HTTP to a collector. Unset: spans exist (so logs carry trace ids)
# but are not exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=1
# Names this process in logs and traces (trip-api, or trip-worker for the worker).
# SERVICE_NAME=trip-api
# Opens GET /metrics (Prometheus) and GET /ops/status for whoever sends
# "Authorization: Bearer <this>". Unset, both answer 404. At least 24 characters.
# Generate with: openssl rand -base64 32
# OPS_TOKEN=
# A worker started without the API can serve /live and /metrics on this port.
# WORKER_METRICS_PORT=9464
# A store operation slower than this is counted and logged by name (never its arguments).
SLOW_DB_MS=250
# Whether logged errors include the exception's message. Off by default in production:
# messages often quote what was rejected. The error's class, category and where it was
# thrown are always logged.
# LOG_ERROR_MESSAGES=false
# Optional: what YOU pay a model per million tokens, so the cost metric can be estimated.
# There is no built-in price list; without both, no cost is estimated.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# ─── Knowledge answers (Phase 8) ─────────────────────────────────────────────
# POST /v1/knowledge/ask answers questions from a curated index of policies, rules and
# guides, with citations, or says "Insufficient verified information." It never answers
# about prices, fares, timetables, availability, weather or bookings: those come from
# providers. Off by default. It needs documents ingested first (docs/knowledge.md):
#   npm run build && DATABASE_URL=... npm run ingest:knowledge -w @trip/api -- ./docs.json
KNOWLEDGE_ENABLED=false
# Which index to answer from (one shared index per namespace; nothing per traveller is ever in it).
KNOWLEDGE_NAMESPACE=public
KNOWLEDGE_TIMEOUT_MS=20000
# The embedder. With none of these set, an offline, deterministic hashing embedder is used:
# no network and no key, but it matches shared words, not meaning (docs/knowledge.md says what
# that costs). An OpenAI-compatible /embeddings endpoint, hosted or self-hosted, replaces it.
# The index records which embedder made its vectors and is never searched with another: after
# changing any of these, ingest the documents again. NOT verified against a live service.
# EMBEDDINGS_BASE_URL=http://localhost:11434/v1
# EMBEDDINGS_MODEL=nomic-embed-text
# EMBEDDINGS_DIMENSION=768
# EMBEDDINGS_VERSION=1
# EMBEDDINGS_API_KEY=
# KNOWLEDGE_HASH_DIMENSION=512

# ─── Storage ─────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset for local development: trips are then held in memory
# and lost on restart. It is REQUIRED in production — the service refuses to
# start without it, because a trip someone spent twenty minutes building should
# not evaporate on a deploy.
# DATABASE_URL=postgresql://wayfare:wayfare@localhost:5432/wayfare

# Optional. With Redis, rate-limit counters and the provider cache (places, routes,
# things to do) are shared by every API process, so a limit holds however many run.
# Without it, both are per process. Redis is never the source of truth: trips, searches
# and sessions live in PostgreSQL, and if Redis stops answering the limits keep applying
# per process instead of switching off. The search queue also lives in PostgreSQL.
# REDIS_URL=redis://localhost:6379

# ─── Sign-in ─────────────────────────────────────────────────────────────────
# Anyone can plan without signing in: they get a private session (a cookie) and
# their trips belong to it. Signing in by emailed link, with no password, keeps
# those trips across devices.
#
# Keys the hash of every session cookie and sign-in link before it is stored,
# so a copy of the database cannot be used to sign in. REQUIRED in production
# (>= 32 characters). Generate with: openssl rand -base64 48
# (JWT_SECRET is still read as an older name for it.)
# SESSION_SECRET=
SESSION_TTL_DAYS=30
COOKIE_NAME=tp_session
# Cookies are Secure (HTTPS-only) in production and not otherwise. Set false
# only for plain-HTTP local use of a production build.
# COOKIE_SECURE=false
# Use "none" (with COOKIE_SECURE=true) only if the web app and the API are on
# unrelated sites; lax is right for localhost and for subdomains of one domain.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=example.com

# Where the web app lives: sign-in links point at it.
WEB_BASE_URL=http://localhost:3000
# How a sign-in link reaches a person:
#   console  prints it to the log (development only; refused in production)
#   webhook  POSTs {type, to, subject, text, link} as JSON to MAIL_WEBHOOK_URL,
#            which hands it to whatever mail service you use
#   disabled turns email sign-in off (the default in production)
# Unset means webhook if MAIL_WEBHOOK_URL is set, otherwise console in
# development and disabled in production.
# MAILER=console
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_MAX_PER_HOUR=5

###############################################################################
# Travel providers
#
# Each block below enables one adapter. Omit a block and its capability is
# disabled: the UI then says which provider is missing and what it would add.
###############################################################################

# ─── Every provider call ─────────────────────────────────────────────────────
# A backstop on ONE call to any provider, in ms, on top of each adapter's own
# timeout and retries. A provider that has not answered by then is reported as
# timed out and the search carries on with the others. The search's own time is divided
# among its stages, so no call can outlast the share of the search it belongs to.
PROVIDER_CALL_TIMEOUT_MS=45000
# A provider that fails this many times in a row stops being called (its circuit opens)
# until the recovery time passes and one probe call succeeds. Per provider and capability.
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RECOVERY_MS=30000
# Retries of a safe request (a GET) on a network failure, a timeout or a 5xx, and the
# longest wait between attempts. Retries stop when the call's time is up or the
# provider has used its retry budget. A 4xx and a 429 are never retried.
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_MAX_DELAY_MS=3000
# Caching of places, routes and things to do (never flights, hotels or anything about a
# person). Time to live in seconds; the entry count bounds the in-process cache.
CACHE_ENABLED=true
CACHE_TTL_GEOCODING_S=86400
CACHE_TTL_ROUTING_S=21600
CACHE_TTL_ACTIVITIES_S=21600
CACHE_MAX_ENTRIES=2000

# ─── Place lookup (OpenStreetMap Nominatim) ──────────────────────────────────
# Required for anything to work at all: a journey cannot be classified as
# domestic or international without resolving both places to a country.
# The public instance requires an identifying contact address in the User-Agent
# and allows at most one request per second. Self-host for anything real.
NOMINATIM_USER_AGENT=wayfare-dev (your-email@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_MIN_INTERVAL_MS=1100

# ─── Flights and hotels (Amadeus Self-Service) ───────────────────────────────
# Free sandbox keys: https://developers.amadeus.com/self-service
# The test environment returns real but cached inventory; the UI labels prices
# as coming from the test environment so nobody mistakes them for live fares.
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
AMADEUS_MIN_INTERVAL_MS=120

# ─── Routing, transfers and self-drive (OSRM) ────────────────────────────────
# The demo server is rate-limited and offers no uptime guarantee. Self-host for
# anything beyond local development: https://github.com/Project-OSRM/osrm-backend
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_MIN_INTERVAL_MS=250

# ─── Things to do and traffic-aware transfers (Google Maps Platform) ─────────
# Billed. Enables opening hours, which is what stops the scheduler sending
# people to a museum on the day it is closed.
# GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MIN_INTERVAL_MS=50

# ─── Rail ────────────────────────────────────────────────────────────────────
# There is no global open rail API, and operators that expose one require a
# commercial agreement per deployment. Point this at a service YOU are
# authorised to use that implements the surface-transport contract documented
# in docs/providers.md. Until then, rail searches return "not configured".
# RAIL_PROVIDER_URL=https://rail-adapter.internal.example.com
# RAIL_PROVIDER_KEY=
# RAIL_PROVIDER_LABEL=Indian Railways (via your adapter)
# RAIL_PROVIDER_COVERAGE=IN
RAIL_PROVIDER_TIMEOUT_MS=15000

# ─── Bus ─────────────────────────────────────────────────────────────────────
# Same contract, same terms as rail.
# BUS_PROVIDER_URL=https://bus-adapter.internal.example.com
# BUS_PROVIDER_KEY=
# BUS_PROVIDER_LABEL=Bus operator (via your adapter)
# BUS_PROVIDER_COVERAGE=IN
BUS_PROVIDER_TIMEOUT_MS=15000

# ─── Ground transport tariffs ────────────────────────────────────────────────
# Routing providers give real distance and duration but no fare. These operator-
# configured tariffs are the ONLY source of a transfer cost estimate, and every
# figure derived from them is labelled "modelled, not quoted" in the UI.
# Omit this and transfers are shown with distance and time but no price.
# JSON array with one INR entry; amounts in rupees. The service refuses to
# start with a tariff in any other currency.
GROUND_TRANSPORT_TARIFFS=[{"currency":"INR","baseFare":50,"perKm":18,"perMinute":2,"nightMultiplier":1.25}]

# ─── Self-drive vehicle profile ──────────────────────────────────────────────
# Used to model the running cost of driving your own car. Tolls and parking are
# NOT included and the offer says so. Omit this and drives are shown with
# distance and time only. Currency must be INR.
SELF_DRIVE_PROFILE={"currency":"INR","consumptionPer100Km":7.5,"energyPrice":105,"perKmAllowance":1.5,"maxDrivingHoursBeforeBreak":3,"breakMinutes":30,"averageOccupancy":2}

###############################################################################
# Language model
#
# Used ONLY to interpret what a traveller types when changing a plan. It never
# sources a price, schedule or availability, and every plan is validated by
# deterministic rules afterwards. With nothing configured, plain-language
# changes fall back to keyword rules and planning is unaffected.
###############################################################################

# Anthropic (default when ANTHROPIC_API_KEY is set)
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Any OpenAI-compatible endpoint: OpenAI, Azure, Ollama, vLLM, LM Studio,
# OpenRouter. Set LLM_BASE_URL to use this instead of Anthropic.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b
# LLM_LABEL=Local Llama
LLM_MAX_OUTPUT_TOKENS=2048
# Ceiling on one model request, in ms. A slow or failing model falls back to keyword
# rules (and the reason is logged) rather than keeping a traveller waiting.
LLM_TIMEOUT_MS=20000

###############################################################################
# Web app
###############################################################################
NEXT_PUBLIC_API_URL=http://localhost:4000
